# copy to .env and edit
PORT=5000
MONGO_URI=mongodb://localhost:27017
MONGO_DB=truthlens
JWT_SECRET=change-this-to-a-long-random-string

# First admin account, created automatically the first time the server starts
ADMIN_EMAIL=admin@truthlens.com
ADMIN_PASSWORD=choose-a-strong-password
# Optional: fixed 2FA key for the admin. Leave empty and the server prints a new one (and a QR code) on first start
ADMIN_2FA_SECRET=
# Development only: this code is accepted as a 2FA code. DELETE this line before the demo
DEV_2FA_CODE=123456

# Python ML service (truthlens-ml-service), used by the Analyze an Article page
ML_URL=http://localhost:8000

# Admin "Run crawl now" button (Windows paths)
ML_DIR=C:\path\to\truthlens-ml-service
ML_PYTHON=C:\path\to\truthlens-ml-service\.venv\Scripts\python.exe
CRAWLER_DIR=C:\path\to\crawler
CRAWLER_PYTHON=C:\path\to\crawler\.venv\Scripts\python.exe

# "Continue with Google" (login, sign-up and admin login). Client ID from Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID (Web application). Leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=
# Optional: Gmail addresses that may sign in to the admin account with Google (2FA code still needed)
ADMIN_GOOGLE_EMAILS=

# Forgot password e-mails (npm install nodemailer). Gmail: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste its 16 letters into SMTP_PASS.
# Without these, the reset link is printed in this terminal instead of being e-mailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TruthLens <your.address@gmail.com>"
# Where the reset link points (the React app)
FRONTEND_URL=http://localhost:5173
